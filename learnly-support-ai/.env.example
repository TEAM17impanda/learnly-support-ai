# Опційно. Без ключа система працює на rule-based fallback (демо все одно повне).
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
# copilot = усі дії чекають підтвердження; auto_low_risk = low-risk дії виконуються самі
AUTONOMY=copilot
# SQLite-файл бази (створюється сам). Видаліть його, щоб почати демо з нуля
DB_PATH=data/learnly.db
